[
  {
    "value": "Stolen {flare.events.cc.brand} credit card from {flare.events.cc.bank} (BIN {flare.events.cc.bin}) on {event.provider}",
    "conditions": [
      { "field": "flare.events.type", "value": "cc" },
      { "field": "flare.events.cc.brand" },
      { "field": "flare.events.cc.bank" },
      { "field": "flare.events.cc.bin" },
      { "field": "event.provider" }
    ]
  },
  {
    "value": "Stolen credit card (BIN {flare.events.cc.bin}) on {event.provider}",
    "conditions": [
      { "field": "flare.events.type", "value": "cc" },
      { "field": "flare.events.cc.bin" },
      { "field": "event.provider" }
    ]
  },
  {
    "value": "{flare.events.type} event from {event.provider}: {event.reason}",
    "conditions": [
      { "field": "flare.events.type" },
      { "field": "event.provider" },
      { "field": "event.reason" }
    ]
  },
  {
    "value": "Stealer log infection on {host.ip} ({flare.events.stealer_log.malware_family})",
    "conditions": [
      { "field": "flare.events.type", "value": "stealer_log" },
      { "field": "host.ip" },
      { "field": "flare.events.stealer_log.malware_family" }
    ]
  },
  {
    "value": "{flare.events.type} event from {event.provider}",
    "conditions": [
      { "field": "flare.events.type" },
      { "field": "event.provider" }
    ]
  },
  {
    "value": "Infected device {source.ip} ({flare.events.stealer_log.malware_family}), stolen credentials: {flare.events.stealer_log.credential_count}",
    "conditions": [
      { "field": "flare.events.type", "value": "stealer_log" },
      { "field": "source.ip" },
      { "field": "flare.events.stealer_log.malware_family" },
      { "field": "flare.events.stealer_log.credential_count" },
      { "field": "event.provider" },
      { "field": "flare.events.uid" }
    ]
  },
  {
    "value": "Infected device ({flare.events.stealer_log.malware_family}) on {event.provider}, stolen credentials: {flare.events.stealer_log.credential_count}",
    "conditions": [
      { "field": "flare.events.type", "value": "stealer_log" },
      { "field": "flare.events.stealer_log.malware_family" },
      { "field": "flare.events.stealer_log.credential_count" },
      { "field": "event.provider" },
      { "field": "flare.events.uid" }
    ]
  },
  {
    "value": "Infected device on {event.provider}, stolen credentials: {flare.events.stealer_log.credential_count}",
    "conditions": [
      { "field": "flare.events.type", "value": "stealer_log" },
      { "field": "flare.events.stealer_log.credential_count" },
      { "field": "event.provider" },
      { "field": "flare.events.uid" }
    ]
  },
  {
    "value": "Compromised device ({host.geo.name}) listed on {event.provider} for {flare.events.stealer_log.price} {flare.events.stealer_log.currency}",
    "conditions": [
      { "field": "flare.events.type", "value": "bot" },
      { "field": "event.provider" },
      { "field": "host.geo.name" },
      { "field": "flare.events.stealer_log.price" },
      { "field": "flare.events.stealer_log.currency" }
    ]
  },
  {
    "value": "Compromised device listed on {event.provider} for {flare.events.stealer_log.price} {flare.events.stealer_log.currency}",
    "conditions": [
      { "field": "flare.events.type", "value": "bot" },
      { "field": "event.provider" },
      { "field": "flare.events.stealer_log.price" },
      { "field": "flare.events.stealer_log.currency" }
    ]
  },
  {
    "value": "Secret detected in {flare.events.driller.project_name} ({event.reason})",
    "conditions": [
      { "field": "flare.events.type", "value": "driller" },
      { "field": "flare.events.driller.type" },
      { "field": "flare.events.driller.project_name" },
      { "field": "event.reason" },
      { "field": "flare.events.driller.secret_detected", "value": true },
      { "field": "flare.events.driller.secret_detection_rule_ids" }
    ]
  },
  {
    "value": "Issue \"{flare.events.driller.issue_title}\" in {flare.events.driller.project_name} ({event.reason})",
    "conditions": [
      { "field": "flare.events.type", "value": "driller" },
      { "field": "flare.events.driller.type", "value": "issue" },
      { "field": "flare.events.driller.issue_title" },
      { "field": "flare.events.driller.project_name" },
      { "field": "event.reason" }
    ]
  },
  {
    "value": "Mention in {flare.events.driller.project_name} ({event.reason})",
    "conditions": [
      { "field": "flare.events.type", "value": "driller" },
      { "field": "flare.events.driller.type" },
      { "field": "flare.events.driller.project_name" },
      { "field": "event.reason" }
    ]
  },
  {
    "value": "Leaked credential {user.name} with its password in {flare.events.leaked_credential.leak_source_name}",
    "conditions": [
      { "field": "flare.events.type", "value": "leaked_credential" },
      { "field": "user.name" },
      { "field": "flare.events.leaked_credential.leak_source_name" },
      { "field": "flare.events.leaked_credential.password_present", "value": true }
    ]
  },
  {
    "value": "Leaked credential {user.name} without password in {flare.events.leaked_credential.leak_source_name}",
