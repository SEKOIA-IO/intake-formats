[
  {
    "value": "Flare {flare.events.type} event from {event.provider}: {event.reason}",
    "conditions": [
      { "field": "flare.events.type" },
      { "field": "event.provider" },
      { "field": "event.reason" }
    ]
  },
  {
    "value": "Flare stealer log infection on {host.ip} ({flare.events.stealer_log.malware_family})",
    "conditions": [
      { "field": "flare.events.type", "value": "stealer_log" },
      { "field": "host.ip" },
      { "field": "flare.events.stealer_log.malware_family" }
    ]
  }
]
