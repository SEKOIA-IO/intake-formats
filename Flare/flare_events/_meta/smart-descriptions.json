[
  {
    "value": "Flare stolen {flare.events.cc.brand} credit card from {flare.events.cc.bank} (BIN {flare.events.cc.bin}) on {event.provider}",
    "conditions": [
      { "field": "flare.events.type", "value": "cc" },
      { "field": "flare.events.cc.brand" },
      { "field": "flare.events.cc.bank" },
      { "field": "flare.events.cc.bin" },
      { "field": "event.provider" }
    ]
  },
  {
    "value": "Flare stolen credit card (BIN {flare.events.cc.bin}) on {event.provider}",
    "conditions": [
      { "field": "flare.events.type", "value": "cc" },
      { "field": "flare.events.cc.bin" },
      { "field": "event.provider" }
    ]
  },
  {
    "value": "Flare {flare.events.type} event from {event.provider}: {event.reason}",
    "conditions": [
      { "field": "flare.events.type" },
      { "field": "event.provider" },
      { "field": "event.reason" }
    ]
  },
  {
    "value": "Flare stealer log infection on {host.ip} ({flare.events.stealer_log.malware_family})",
    "conditions": [
      { "field": "flare.events.type", "value": "stealer_log" },
      { "field": "host.ip" },
      { "field": "flare.events.stealer_log.malware_family" }
    ]
  },
  {
    "value": "Flare {flare.events.type} event from {event.provider}",
    "conditions": [
      { "field": "flare.events.type" },
      { "field": "event.provider" }
    ]
  }
]
