  {
    "value": "Network connection from {source.ip} to {destination.ip} ({network.transport})",
    "conditions": [
      {
        "field": "event.dataset",
        "value": "conn"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "destination.ip",
        "type": "requested"
      }
    ]
  }
