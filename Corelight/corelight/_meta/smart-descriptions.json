[
  {
    "value": "Suricata IDS alert \"{rule.name}\" raised by {source.ip} towards {destination.ip}",
    "conditions": [
      {
        "field": "rule.name"
      },
      {
        "field": "event.dataset",
        "value": "suricata_corelight"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "destination.ip",
        "type": "requested"
      }
    ]
  },
  {
    "value": "Threat intelligence match on indicator {threat.indicator.name} seen for {source.ip}",
    "conditions": [
      {
        "field": "threat.indicator.name"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "destination.ip",
        "type": "requested"
      }
    ]
  },
  {
    "value": "HTTP {http.request.method} request from {source.ip} to {url.domain}",
    "conditions": [
      {
        "field": "http.request.method"
      },
      {
        "field": "url.domain"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "destination.ip",
        "type": "requested"
      }
    ]
  },
  {
    "value": "TLS connection from {source.ip} to {tls.client.server_name}",
    "conditions": [
      {
        "field": "tls.client.server_name"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "destination.ip",
        "type": "requested"
      }
    ]
  },
  {
    "value": "DNS query {dns.question.name} from {source.ip}",
    "conditions": [
      {
        "field": "dns.question.name"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "destination.ip",
        "type": "requested"
      }
    ]
  },
  {
    "value": "File {file.hash.sha256} ({file.mime_type}) observed between {source.ip} and {destination.ip}",
    "conditions": [
      {
        "field": "file.hash.sha256"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "destination.ip",
        "type": "requested"
      }
    ]
  },
  {
    "value": "Notice \"{rule.name}\" raised by {source.ip}",
    "conditions": [
      {
        "field": "rule.name"
      },
      {
        "field": "event.dataset",
