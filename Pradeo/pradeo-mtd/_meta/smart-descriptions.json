[
  {
    "value": "{pradeo.metadata.type} done by system",
    "conditions": [
      {
        "field": "pradeo.metadata.source",
        "value": "system"
      }
    ]
  },
  {
    "value": "New device {pradeo.device.id} detected",
    "conditions": [
      {
        "field": "event.action",
        "value": "DeviceDetection"
      },
      {
        "field": "pradeo.device.id"
      }
    ]
  },
  {
    "value": "New action {event.action} by {user.email}",
    "conditions": [
      {
        "field": "pradeo.metadata.source",
        "value": "admin"
      },
      {
        "field": "user.email"
      },
      {
        "field": "event.action"
      }
    ]
  },
  {
