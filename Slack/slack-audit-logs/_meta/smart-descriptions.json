[
  {
    "value": "{user.name} performed {event.action} in {organization.name}",
    "conditions": [
      {
        "field": "user.name"
      },
      {
        "field": "event.action"
      },
      {
        "field": "organization.name"
      }
    ]
  },
  {
    "value": "{user.name} signed in to {organization.name} from {source.ip}",
    "conditions": [
      {
        "field": "user.name"
      },
      {
        "field": "source.ip"
      },
      {
        "field": "organization.name"
      },
      {
        "field": "event.action",
        "value": "user_login"
      }
    ],
    "relationships": [
      {
        "source": "source.ip",
        "target": "user.name",
        "type": "signed in as"
      }
    ]
  },
