[
  {
    "value": "Conditional Access policy {azure.entraid.properties.conditionalAccessPolicy.displayName} changed from {azure.entraid.properties.conditionalAccessPolicy.oldState} to {azure.entraid.properties.conditionalAccessPolicy.newState} by {user.name}",
    "conditions": [
      { "field": "azure.entraid.properties.conditionalAccessPolicy.displayName" },
      { "field": "azure.entraid.properties.conditionalAccessPolicy.oldState" },
      { "field": "azure.entraid.properties.conditionalAccessPolicy.newState" },
      { "field": "user.name" }
    ]
  },
  {
    "value": "{event.action} on target user {user.target.name} by {user.name} ({event.outcome})",
    "conditions": [
      { "field": "event.action" },
      { "field": "event.outcome" },
      { "field": "user.target.name" },
      { "field": "user.name" }
    ]
  },
  {
    "value": "Application {azure.entraid.properties.targetServicePrincipalDisplayName} ({azure.entraid.properties.appId}) performed {event.action} ({event.outcome})",
    "conditions": [
      { "field": "azure.entraid.properties.targetServicePrincipalDisplayName" },
      { "field": "azure.entraid.properties.appId" },
      { "field": "event.action" },
      { "field": "event.outcome" }
    ]
  },
  {
    "value": "{event.action} from {source.ip} using {user_agent.original} ({event.outcome})",
    "conditions": [
      { "field": "event.action" },
      { "field": "source.ip" },
      { "field": "user_agent.original" },
      { "field": "event.outcome" }
    ]
  },
  {
    "value": "Sign-in {event.outcome} for {user.name} from {source.ip} (code {event.code}, client {azure.entraid.properties.clientAppUsed})",
    "conditions": [
      { "field": "event.code" },
      { "field": "azure.entraid.properties.clientAppUsed" },
      { "field": "user.name" },
      { "field": "source.ip" },
      { "field": "event.outcome" }
    ]
  },
  {
    "value": "{azure.entraid.properties.operationType} operation on {event.dataset} by {user.name} ({event.outcome})",
    "conditions": [
      { "field": "azure.entraid.properties.operationType" },
      { "field": "event.dataset" },
      { "field": "user.name" },
      { "field": "event.outcome" }
    ]
  },
  {
    "value": "User {user.email} consented to {azure.entraid.properties.targetServicePrincipalDisplayName} from {source.ip} ({action.outcome})",
    "conditions": [
      { "field": "action.name", "value": "Consent to application" },
      { "field": "azure.entraid.properties.targetServicePrincipalDisplayName" },
      { "field": "azure.entraid.properties.appId" },
      { "field": "user.email" },
      { "field": "source.ip" }
    ]
  },
  {
    "value": "{action.name} by {user.email} from {source.ip} ({action.outcome})",
    "conditions": [
      { "field": "action.name", "value": "Consent to application" },
      { "field": "user.email" },
      { "field": "source.ip" }
    ]
  },
  {
    "value": "Access status {azure.entraid.properties.conditionalAccessStatus} for user {user.name} from {source.ip} and risk state {azure.entraid.properties.riskState}",
    "conditions": [
      { "field": "azure.entraid.properties.conditionalAccessStatus" },
      { "field": "azure.entraid.properties.riskState" },
      { "field": "user.name" },
      { "field": "source.ip" }
    ]
  },
  {
    "value": "Event from {event.dataset} for user {user.name} from {source.ip}",
    "conditions": [
      { "field": "event.dataset" },
      { "field": "user.name" },
      { "field": "source.ip" }
    ]
  },
  {
    "value": "Operation {event.action} with status {event.outcome} on {event.dataset} by user {user.name}",
    "conditions": [
      { "field": "event.action" },
      { "field": "event.outcome" },
      { "field": "event.dataset" },
      { "field": "user.name" }
    ]
  },
  {
    "value": "Operation {event.action} with status {event.outcome} on {event.dataset} by user {user.email}",
    "conditions": [
      { "field": "event.action" },
      { "field": "event.outcome" },
      { "field": "event.dataset" },
      { "field": "user.email" }
    ]
  },
  {
    "value": "Operation {event.action} with status {event.outcome} on {event.dataset}",
    "conditions": [
      { "field": "event.action" },
      { "field": "event.outcome" },
      { "field": "event.dataset" }
    ]
  }
]
