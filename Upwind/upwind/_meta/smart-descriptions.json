[
  {
    "value": "{user.name} triggered a {threat.technique.name} detection: {event.reason}",
    "conditions": [
      { "field": "event.dataset", "value": "cloud_trail" },
      { "field": "user.name" }
    ],
    "relationships": [
      { "source": "user.name", "target": "host.name", "type": "triggered alert on" }
    ]
  },
  {
    "value": "Upwind detected {threat.technique.name} ({threat.tactic.name}) on {host.name}",
    "conditions": [
      { "field": "threat.technique.name" },
      { "field": "host.name" }
    ],
    "relationships": [
      { "source": "threat.technique.name", "target": "host.name", "type": "detected on" }
    ]
  },
  {
    "value": "Upwind Security alert: {event.reason}",
    "conditions": [
      { "field": "event.reason" }
    ]
  },
  {
    "value": "Upwind Security threat detection",
    "conditions": []
  }
]
